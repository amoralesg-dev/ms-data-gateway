                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"creditorCode\": \"60000011\",\n  \"businessRelationCode\": \"60000011\",\n  \"businessRelationName1\": \"HUGO CESAR MUNTANE RODRIGUEZ\"\n}"
